#!/usr/bin/ash
run_hook() {
    if /usr/lib/rstarsleep/initramfs-finalize; then return 0; fi
    echo '错误：RStarSleep 继承失败；不会启动不完整的根目录。 / ERROR: RStarSleep inheritance failed; the incomplete root will not be booted.' >&2
    echo '恢复 shell：请检查错误、重试，或使用 reboot -f 选择较旧版本。 / Recovery shell: inspect the error, retry, or use reboot -f to select an older version.' >&2
    exec /usr/lib/rstarsleep/tools/sh -c '
        /usr/lib/rstarsleep/tools/sh -i </dev/console >/dev/console 2>&1 || :
        /usr/lib/rstarsleep/tools/busybox poweroff -f || :
        while :; do /usr/lib/rstarsleep/tools/sleep 3600 || :; done
    '
}
